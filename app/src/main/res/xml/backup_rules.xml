<?xml version="1.0" encoding="utf-8"?>
<!--
   Pravidlá zálohovania pre Android do verzie 11 (API 30).

   Z databázy sa zálohuje LEN nastavenie jazyka (SharedPreferences).
   Výsledky skenov sa vedome nezálohujú: základňa patrí ku konkrétnemu
   telefónu. Keby sa preniesla na iný, prvý sken by ju porovnal s úplne
   inou sadou aplikácií a vypísal by zmeny, ktoré sa na tom zariadení
   nikdy nestali.
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
