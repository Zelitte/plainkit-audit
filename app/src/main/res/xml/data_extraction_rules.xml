<?xml version="1.0" encoding="utf-8"?>
<!--
   Pravidlá zálohovania a prenosu pre Android 12 (API 31) a novší.

   Výsledky skenov sa nezálohujú ani neprenášajú na iné zariadenie:
   základňa, voči ktorej sa počíta „čo sa zmenilo", patrí ku konkrétnemu
   telefónu. Prenesená na iný by vyrobila zmeny, ktoré sa tam nestali.
   Nastavenie jazyka v SharedPreferences prenesené byť môže.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
